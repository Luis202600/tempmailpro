# ─── Base de datos (obligatoria) ────────────────────────────────────────────
# Local: ruta relativa a la carpeta prisma/. La carpeta db/ ya existe.
# La app crea las tablas automáticamente al arrancar (src/lib/db.ts).
DATABASE_URL=file:../db/custom.db

# ─── URL pública del sitio (recomendada) ────────────────────────────────────
# Sin barra final. La usan el canonical, Open Graph, sitemap.xml y robots.txt.
# En local puedes dejarla apuntando a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google AdSense (opcional) ──────────────────────────────────────────────
# Sin este valor no se cargan anuncios ni se publica /ads.txt.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
